{
  "segments": [
    {
      "when": "git.repo == ''",
      "children": [
        {
          "expr": "pwd.smart",
          "style": { "color": "31" }
        },
        {
          "expr": "pwd.name",
          "style": { "color": "39", "bold": true }
        }
      ]
    },
    {
      "when": "git.repo != ''",
      "children": [
        {
          "expr": "git.owner",
          "style": { "color": "240", "suffix": "/" }
        },
        {
          "expr": "git.repo",
          "style": { "color": "245", "bold": true }
        }
      ]
    },
    {
      "expr": "git.branch",
      "when": "git.branch != '' && git.branch != 'main'",
      "style": { "color": "whiteBright", "bold": true, "prefix": "  @" }
    },
    {
      "expr": "git.modified",
      "when": "value > 0",
      "style": { "color": "yellow", "prefix": "  *" }
    },
    {
      "expr": "git.untracked",
      "when": "value > 0",
      "style": { "color": "cyan", "prefix": "  ?" }
    },
    {
      "expr": "agent.name",
      "when": "agent.active",
      "style": { "color": "magentaBright", "bold": true, "prefix": "  " }
    },
    {
      "expr": "effort.level",
      "when": "effort.level != '' && effort.level != 'medium'",
      "style": { "color": "cyan", "prefix": "  " }
    },
    {
      "value": "fast",
      "when": "effort.fast",
      "style": { "color": "magenta", "prefix": "  " }
    },
    {
      "expr": "context.percent.used",
      "when": "value >= 50",
      "style": { "color": "yellow", "prefix": "  " }
    },
    {
      "value": "5h:",
      "when": "limits.session.percent >= 80",
      "style": { "color": "240", "prefix": "  " }
    },
    {
      "expr": "limits.session.percent",
      "when": "limits.session.percent >= 80",
      "style": { "color": "red" }
    },
    {
      "expr": "cost.total",
      "when": "cost.total > 5",
      "style": { "color": "red", "prefix": "  " }
    },
    {
      "expr": "session.duration.total",
      "when": "session.duration.total_min > 60",
      "style": { "color": "magenta", "prefix": "  " }
    }
  ]
}
