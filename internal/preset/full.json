{
  "segments": [
    {
      "expr": "pwd.smart",
      "style": {
        "color": "31",
        "prefix": "\uf07b "
      }
    },
    {
      "expr": "pwd.name",
      "style": {
        "color": "39",
        "bold": true
      }
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "expr": "git.branch",
          "style": {
            "color": "whiteBright",
            "bold": true,
            "prefix": "\ue0a0 "
          }
        },
        {
          "style": {
            "prefix": " · "
          },
          "children": [
            {
              "expr": "git.insertions",
              "when": "value > 0",
              "style": {
                "color": "green",
                "prefix": "+"
              }
            },
            {
              "expr": "git.deletions",
              "when": "value > 0",
              "style": {
                "color": "red",
                "prefix": " -"
              }
            }
          ]
        }
      ]
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "expr": "model.name",
          "style": {
            "color": "white"
          }
        },
        {
          "expr": "model.id",
          "style": {
            "color": "240",
            "prefix": " "
          }
        },
        {
          "expr": "agent.name",
          "when": "agent.active",
          "style": {
            "color": "magentaBright",
            "bold": true,
            "prefix": " \uf2c0 "
          }
        }
      ]
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "expr": "effort.level",
          "when": "effort.level != ''",
          "style": {
            "color": "cyan",
            "prefix": "\uf0e7 "
          }
        },
        {
          "value": "\uf0eb",
          "when": "effort.thinking",
          "style": {
            "color": "yellow",
            "prefix": " "
          }
        },
        {
          "value": "\uf135",
          "when": "effort.fast",
          "style": {
            "color": "magenta",
            "prefix": " "
          }
        }
      ]
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "expr": "context.tokens",
          "style": {
            "color": "white",
            "bold": true,
            "prefix": "\uf0e4 "
          }
        },
        {
          "expr": "context.size",
          "style": {
            "color": "white",
            "prefix": "/"
          }
        },
        {
          "expr": "context.percent.used",
          "style": {
            "color": "white",
            "prefix": " (",
            "suffix": ")"
          }
        },
        {
          "expr": "context.percent.remaining",
          "when": "value > 0",
          "style": {
            "color": "white",
            "prefix": " [",
            "suffix": " free]"
          }
        }
      ]
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "expr": "cost.usd",
          "style": {
            "color": "yellow",
            "bold": true
          }
        }
      ]
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "value": "5h:",
          "when": "limits.session.percent > 0",
          "style": {
            "color": "240"
          }
        },
        {
          "expr": "limits.session.percent",
          "when": "limits.session.percent > 0",
          "style": {
            "color": "yellow"
          }
        },
        {
          "value": "7d:",
          "when": "limits.weekly.percent > 0",
          "style": {
            "color": "240",
            "prefix": " "
          }
        },
        {
          "expr": "limits.weekly.percent",
          "when": "limits.weekly.percent > 0",
          "style": {
            "color": "cyan"
          }
        },
        {
          "expr": "limits.session.reset",
          "when": "limits.session.reset != ''",
          "style": {
            "color": "240",
            "prefix": " ~"
          }
        }
      ]
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "expr": "claude.version",
          "style": {
            "color": "240",
            "prefix": "v"
          }
        },
        {
          "style": {
            "prefix": " · "
          },
          "children": [
            {
              "expr": "claude.style",
              "style": {
                "color": "cyan"
              }
            }
          ]
        }
      ]
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "expr": "session.duration.total",
          "style": {
            "color": "magenta",
            "prefix": "\uf017 "
          }
        },
        {
          "style": {
            "prefix": " · "
          },
          "children": [
            {
              "expr": "session.name",
              "when": "session.name != ''",
              "style": {
                "color": "blueBright"
              }
            }
          ]
        }
      ]
    },
    {
      "style": {
        "prefix": " | ",
        "color": "240"
      },
      "children": [
        {
          "expr": "session.lines-added",
          "when": "value > 0",
          "style": {
            "color": "green",
            "prefix": "+"
          }
        },
        {
          "expr": "session.lines-removed",
          "when": "value > 0",
          "style": {
            "color": "red",
            "prefix": " -"
          }
        }
      ]
    }
  ]
}
